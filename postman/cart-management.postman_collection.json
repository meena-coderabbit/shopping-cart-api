{
  "info": {
    "name": "Shopping Cart Demo — Cart Management (#3)",
    "description": "Covers the cart endpoints from issue #3: view / add / update / remove / clear. Test scripts assert the issue's acceptance criteria (status codes, quantity validation, stock ceiling 409, merge-on-add, and subtotal reconciliation).\n\nUsage:\n1. Set `baseUrl` (default http://localhost:3000).\n2. Set `productId` to an existing product id (create one via the Products API first), and `inStockQty` to a quantity that is <= its available stock.\n3. Run the folder top-to-bottom (Collection Runner) — later requests reuse ids captured by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "inStockQty", "value": "2", "type": "string" },
    { "key": "overStockQty", "value": "999999", "type": "string" },
    { "key": "cartItemId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add item to cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": {{inStockQty}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const item = pm.response.json();",
              "pm.test('returns the added line item', () => {",
              "  pm.expect(item).to.have.property('id');",
              "  pm.expect(item.productId).to.eql(pm.collectionVariables.get('productId'));",
              "});",
              "if (item && item.id) pm.collectionVariables.set('cartItemId', item.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Add same product again (should merge)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "// Acceptance: adding an existing product merges quantities instead of duplicating a line.",
              "pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/cart', method: 'GET' }, (err, res) => {",
              "  if (err) return;",
              "  const cart = res.json();",
              "  const lines = (cart.items || []).filter(i => i.productId === pm.collectionVariables.get('productId'));",
              "  pm.test('product appears as a single merged line', () => pm.expect(lines.length).to.eql(1));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "View cart",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const cart = pm.response.json();",
              "pm.test('has items array and subtotal', () => {",
              "  pm.expect(cart).to.have.property('items').that.is.an('array');",
              "  pm.expect(cart).to.have.property('subtotal');",
              "});",
              "pm.test('lineTotal = unitPrice * quantity for every line', () => {",
              "  cart.items.forEach(i => pm.expect(i.lineTotal).to.eql(i.unitPrice * i.quantity));",
              "});",
              "pm.test('subtotal equals sum of line totals', () => {",
              "  const sum = cart.items.reduce((acc, i) => acc + i.lineTotal, 0);",
              "  pm.expect(cart.subtotal).to.eql(sum);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update item quantity",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items", "{{cartItemId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('quantity updated to 3', () => pm.expect(pm.response.json().quantity).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add with invalid quantity (expect 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request (quantity must be >= 1)', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add exceeding stock (expect 409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": {{overStockQty}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart/items",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict (exceeds available stock)', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Remove line item",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cart/items/{{cartItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items", "{{cartItemId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "Remove missing line item (expect 404)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/cart/items/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["cart", "items", "does-not-exist"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
          }
        }
      ]
    },
    {
      "name": "Clear cart",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    }
  ]
}
